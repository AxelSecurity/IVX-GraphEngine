# ──────────────────────────────────────────────────────────────
# GraphEngine — configurazione via variabili d'ambiente
#
# Copia questo file in `.env` (il `.env` vero è in .gitignore:
# NON committarlo MAI) e valorizza solo le variabili che ti
# servono.  Quasi tutte le variabili sono OPZIONALI: senza
# configurazione il progetto funziona in modalità degradata
# (fallback euristico L5).  Eccezioni: l'API esterna richiede
# API_KEY (senza → 503) e la dashboard richiede il login
# (senza DASHBOARD_ADMIN_PASSWORD l'admin bootstrap nasce con
# password casuale stampata nel log).
#
# ⚠ DOCKER COMPOSE: copia questo file in `.env` nella STESSA
# cartella di docker-compose.yml (la radice del progetto, NON
# dentro data/): è letto da `env_file` e le variabili vengono
# iniettate nell'ambiente del container.  Le variabili sono le
# stesse dell'uso locale — cambia solo il modo in cui arrivano
# al processo (ambiente del container invece di pydantic-settings
# che legge il file dalla working directory).
#
# La lettura è centralizzata in graph_engine/config.py.
# ──────────────────────────────────────────────────────────────

# ── Azure AI Foundry (classificazione L5) — opzionale ────────
# Endpoint del progetto Azure AI Foundry
# (es. https://<progetto>.openai.azure.com).
# Richiede anche AZURE_FOUNDRY_AGENT_ID: si attiva solo se
# ENTRAMBE presenti.  Senza questa coppia, --classify usa il
# fallback euristico deterministico.
AZURE_FOUNDRY_ENDPOINT=

# ID dell'agente Foundry configurato su Azure AI Projects.
# Richiede anche AZURE_FOUNDRY_ENDPOINT.
AZURE_FOUNDRY_AGENT_ID=

# ── Service principal AAD (autenticazione Foundry) — opzionale ────
# Le tre credenziali del service principal usate dal classificatore
# Foundry via ClientSecretCredential (app registration in Entra ID).
# Se presenti TUTTE e tre, il classificatore le usa direttamente —
# autenticazione stabile e riproducibile, senza dipendere da
# `az login`; se assenti, ripiega su DefaultAzureCredential
# (Azure CLI loggata, managed identity, ecc.).
#
# NOTA IMPORTANTE: pydantic-settings NON esporta i valori del .env
# in os.environ, quindi EnvironmentCredential non li vedrebbe MAI:
# è il classificatore a passarli esplicitamente a
# ClientSecretCredential (graph_engine/config.py li legge dal .env).
AZURE_TENANT_ID=

# Client ID (application ID) dell'app registration in Entra ID.
# Richiede anche AZURE_TENANT_ID e AZURE_CLIENT_SECRET.
AZURE_CLIENT_ID=

# Secret dell'app registration.  Richiede anche AZURE_TENANT_ID e
# AZURE_CLIENT_ID.
AZURE_CLIENT_SECRET=

# ── Azure AI Vision (arricchimento bundle L5) — opzionale ───
# Endpoint della risorsa Azure AI Vision RIUSATA — nessuna
# risorsa nuova da creare: si usa la risorsa Cognitive Services
# già attiva per Foundry (regione italynorth), es.
# https://aigpt-pr-it-intelivx-resource.cognitiveservices.azure.com/
# Alimenta l'arricchimento visivo degli screenshot degli stati
# foglia: OCR (SDK moderna azure-ai-vision-imageanalysis) e
# Brand Detection (REST legacy v3.2).
# Richiede anche AZURE_VISION_KEY: si attiva solo se ENTRAMBE
# presenti; altrimenti l'arricchimento visivo è disabilitato
# (nessuna chiamata viene tentata).
AZURE_VISION_ENDPOINT=

# Chiave di accesso della risorsa Azure AI Vision (portale →
# Keys and Endpoint).  Usata nell'header
# Ocp-Apim-Subscription-Key per la REST legacy v3.2 e in
# AzureKeyCredential per la SDK moderna.  NOTA: è
# l'autenticazione a chiave della risorsa Cognitive Services,
# DIVERSA dall'AAD usata per Foundry.
# Richiede anche AZURE_VISION_ENDPOINT.
AZURE_VISION_KEY=

# ── ctlogs.dev (certificate transparency) — opzionale ─
# API key della REST API di ctlogs.dev (https://api.ctlogs.dev),
# rilascita su richiesta via email.  Con la chiave la SAN list dei
# certificati più recenti viene recuperata da /v1/cert/{id} →
# evidenza sibling_domains.  Endpoint fisso e noto — serve solo
# la chiave.  crt.sh è stato rimosso (2026-08-27):
# ctlogs.dev è l'UNICO provider CT.
#
# SENZA questa variabile il provider funziona comunque in modalità
# ANONIMA sull'endpoint pubblico https://ctlogs.dev/search: niente
# SAN list (quindi niente domini fratelli), ma restano disponibili
# la cronologia certificati (evidenza certificate_history: un cert
# emesso da < 30 giorni pesa 0.15).  Quando la chiave arriva, la
# modalità API si attiva automaticamente (cache separata).
CTLOGS_API_KEY=

# ── API esterna (/api/v1/analyze) — OBBLIGATORIO ─────────────
# API key che il servizio chiamante deve inviare nell'header
# `X-API-Key` a ogni richiesta.  Se NON configurata, la route
# risponde 503 (configurazione mancante) — mai aperta.  Accetta più
# chiavi separate da virgola (una per servizio chiamante, così si
# revoca una chiave senza toccare gli altri).  La stessa chiave vale
# anche per sottomissione e polling su /analyses.
# Genera un valore robusto, es.: `openssl rand -hex 32`.
API_KEY=

# ── Concorrenza — opzionale ─────────────────────────────────
# Numero massimo di analisi in esecuzione contemporanea (default 4).
# Le richieste oltre il limite restano "queued" finché si libera uno
# slot.  Aumentarlo solo se CPU/RAM reggono più pagine Chromium.
# MAX_CONCURRENT_ANALYSES=4

# Azioni (click / redirect) di una stessa pagina esplorate in parallelo
# da L4, ognuna su una pagina Chromium propria (default 3; 1 =
# esplorazione sequenziale).  Le pagine aperte arrivano a circa
# MAX_CONCURRENT_ANALYSES × L4_PARALLEL_ACTIONS: dimensionare la RAM.
# L4_PARALLEL_ACTIONS=3

# ── Retention dei file su disco — opzionale ─────────────────
# Giorni dopo cui screenshot, DOM e HAR di un'analisi vengono
# cancellati da data/graph_artifacts (default 30; 0 = mai).  Il DB
# NON viene toccato: verdetti, grafo, evidenze e storico restano.
# Lo stesso job (giornaliero) elimina la cache OSINT scaduta.
# ARTIFACT_RETENTION_DAYS=30

# Altezza massima in pixel dello screenshot di ogni stato (default
# 8000; 0 = pagina intera).  Oltre si cattura solo la parte superiore:
# Azure Vision rifiuta immagini oltre 16000 px e logo, marchio e form
# stanno in alto.  Il DOM salvato resta completo.
# SCREENSHOT_MAX_HEIGHT=8000

# ── Classificatore Foundry: quota e rate limit — opzionale ──
# Run Foundry contemporanei al massimo (default 2): limita le raffiche
# di prompt verso il deployment (quota di token al minuto).  Se Azure
# risponde rate_limit_exceeded / HTTP 429 il run viene ritentato fino a
# 3 volte (attese ~10s, 20s, 40s o quella indicata da Azure) prima di
# ripiegare sul fallback euristico.
# FOUNDRY_MAX_CONCURRENT=2

# ── Log — opzionale ─────────────────────────────────────────
# Livello dei log (DEBUG, INFO, WARNING, ERROR; default INFO).  Le
# librerie Azure restano comunque almeno a WARNING (niente dump delle
# intestazioni HTTP) e i GET /health riusciti del healthcheck Docker non
# finiscono nel log di accesso.
# LOG_LEVEL=INFO

# ── Bootstrap amministratore dashboard ──────────────────────
# Al primo avvio (tabella utenti vuota) viene creato l'admin con
# queste credenziali.  Se assenti, l'utente "admin" viene creato
# con una password casuale stampata nel log (cambiarla subito con
# `docker compose exec graph-engine python -m graph_engine.api.auth_cli passwd admin`).
DASHBOARD_ADMIN_USER=
DASHBOARD_ADMIN_PASSWORD=

# --- Provider futuri (esempio, non ancora implementati) ---
# Pattern documentato per aggiungere un nuovo provider a chiave:
#   1. Aggiungere il campo tipizzato in graph_engine/config.py
#   2. Aggiungere una property *_configured se serve una coppia URL+key
#   3. Leggere il valore nel provider via
#      `from graph_engine.config import settings` (mai os.environ diretto)
#   4. Documentare la variabile qui sotto
# VIRUSTOTAL_API_KEY=      # es. verifica reputazione file/hash su VirusTotal
# SHODAN_API_KEY=          # es. banner passivo su Shodan InternetDB
# ABUSEIPDB_API_KEY=       # es. reputazione IP su AbuseIPDB
