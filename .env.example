# ──────────────────────────────────────────────────────────────
# IVX-GraphEngine — configurazione via variabili d'ambiente
#
# Copia questo file in `.env` (il `.env` vero è in .gitignore:
# NON committarlo MAI) e valorizza solo le variabili che ti
# servono.  Tutte le variabili sono OPZIONALI: senza alcuna
# configurazione il progetto funziona in modalità degradata
# (fallback euristico L5, provider di reputazione extra
# disabilitati, endpoint Trellix senza autenticazione).
#
# La lettura è centralizzata in graph_engine/config.py.
# ──────────────────────────────────────────────────────────────

# ── Azure AI Foundry (classificazione L5) — opzionale ────────
# Endpoint del progetto Azure AI Foundry
# (es. https://<progetto>.openai.azure.com).
# Richiede anche AZURE_FOUNDRY_AGENT_ID: si attiva solo se
# ENTRAMBE presenti.  Senza questa coppia, --classify usa il
# fallback euristico deterministico.
AZURE_FOUNDRY_ENDPOINT=

# ID dell'agente Foundry configurato su Azure AI Projects.
# Richiede anche AZURE_FOUNDRY_ENDPOINT.
AZURE_FOUNDRY_AGENT_ID=

# ── Service principal AAD (autenticazione Foundry) — opzionale ────
# Le tre credenziali del service principal usate dal classificatore
# Foundry via ClientSecretCredential (app registration in Entra ID).
# Se presenti TUTTE e tre, il classificatore le usa direttamente —
# autenticazione stabile e riproducibile, senza dipendere da
# `az login`; se assenti, ripiega su DefaultAzureCredential
# (Azure CLI loggata, managed identity, ecc.).
#
# NOTA IMPORTANTE: pydantic-settings NON esporta i valori del .env
# in os.environ, quindi EnvironmentCredential non li vedrebbe MAI:
# è il classificatore a passarli esplicitamente a
# ClientSecretCredential (graph_engine/config.py li legge dal .env).
AZURE_TENANT_ID=

# Client ID (application ID) dell'app registration in Entra ID.
# Richiede anche AZURE_TENANT_ID e AZURE_CLIENT_SECRET.
AZURE_CLIENT_ID=

# Secret dell'app registration.  Richiede anche AZURE_TENANT_ID e
# AZURE_CLIENT_ID.
AZURE_CLIENT_SECRET=

# ── Azure AI Vision (arricchimento bundle L5) — opzionale ───
# Endpoint della risorsa Azure AI Vision RIUSATA — nessuna
# risorsa nuova da creare: si usa la risorsa Cognitive Services
# già attiva per Foundry (regione italynorth), es.
# https://aigpt-pr-it-intelivx-resource.cognitiveservices.azure.com/
# Alimenta l'arricchimento visivo degli screenshot degli stati
# foglia: OCR (SDK moderna azure-ai-vision-imageanalysis) e
# Brand Detection (REST legacy v3.2).
# Richiede anche AZURE_VISION_KEY: si attiva solo se ENTRAMBE
# presenti; altrimenti l'arricchimento visivo è disabilitato
# (nessuna chiamata viene tentata).
AZURE_VISION_ENDPOINT=

# Chiave di accesso della risorsa Azure AI Vision (portale →
# Keys and Endpoint).  Usata nell'header
# Ocp-Apim-Subscription-Key per la REST legacy v3.2 e in
# AzureKeyCredential per la SDK moderna.  NOTA: è
# l'autenticazione a chiave della risorsa Cognitive Services,
# DIVERSA dall'AAD usata per Foundry.
# Richiede anche AZURE_VISION_ENDPOINT.
AZURE_VISION_KEY=

# ── MISP (provider reputazione L2) — opzionale ───────────────
# URL base dell'istanza MISP (es. https://misp.example.org).
# Richiede anche MISP_API_KEY: si attiva solo se ENTRAMBE
# presenti; altrimenti il provider resta disabilitato (nessuna
# chiamata HTTP viene tentata).
MISP_URL=

# API key MISP per la REST API standard.
# Richiede anche MISP_URL.
MISP_API_KEY=

# ── OpenCTI (provider reputazione L2) — opzionale ────────────
# URL base dell'istanza OpenCTI (es. https://opencti.example.org).
# Richiede anche OPENCTI_API_KEY: si attiva solo se ENTRAMBE
# presenti; altrimenti il provider resta disabilitato.
OPENCTI_URL=

# API key OpenCTI per la GraphQL API.
# Richiede anche OPENCTI_URL.
OPENCTI_API_KEY=

# ── ctlogs.dev (fallback certificate transparency) — opzionale ─
# API key della REST API di ctlogs.dev (https://api.ctlogs.dev),
# rilascita su richiesta via email.  Usata SOLO come fallback
# quando crt.sh non risponde (502/timeout): la SAN list dei
# certificati più recenti viene recuperata da /v1/cert/{id}.
# Endpoint fisso e noto — serve solo la chiave (come URLhaus).
#
# SENZA questa variabile il fallback funziona comunque in modalità
# ANONIMA sull'endpoint pubblico https://ctlogs.dev/search: niente
# SAN list (quindi niente domini fratelli), ma restano disponibili
# la cronologia certificati (evidenza certificate_history: un cert
# emesso da < 30 giorni pesa 0.15).  Quando la chiave arriva, la
# modalità API si attiva automaticamente (cache separata).
CTLOGS_API_KEY=

# ── URLhaus (provider reputazione L2) — opzionale ─────────────
# Auth-Key per l'API URLhaus di abuse.ch.  Dal 2025 l'API
# richiede autenticazione: la chiave viene inviata nell'header
# `Auth-Key` di ogni richiesta POST verso
# https://urlhaus-api.abuse.ch/v1/url/ (endpoint invariato).
# Senza questa variabile il provider resta disabilitato (nessuna
# chiamata HTTP viene tentata), come MISP/OpenCTI.
#
# La chiave è GRATUITA: si ottiene registrandosi su
# https://auth.abuse.ch/ (stessa chiave per tutti i servizi
# abuse.ch: URLhaus, Threat Fox, Malware Bazaar, YARAify).
#
# Nota dalla documentazione ufficiale: l'API è gratuita sia per
# uso non commerciale sia commerciale, purché conforme alla fair
# use policy; per costruire un servizio pubblico basato sui dati
# abuse.ch è richiesto un permesso scritto preventivo.
# Verifica i termini attuali su https://urlhaus.abuse.ch/api/
# per il tuo caso d'uso.
URLHAUS_API_KEY=

# ── Endpoint Trellix (/trellix/analyze) — opzionale ──────────
# Se impostata, l'endpoint richiede l'header
# `Authorization: Bearer <token>` su ogni richiesta.
# Se assente (o vuota), l'endpoint è aperto (auth disabilitata).
TRELLIX_API_TOKEN=

# --- Provider futuri (esempio, non ancora implementati) ---
# Pattern documentato per aggiungere un nuovo provider a chiave:
#   1. Aggiungere il campo tipizzato in graph_engine/config.py
#   2. Aggiungere una property *_configured se serve una coppia URL+key
#   3. Leggere il valore nel provider via
#      `from graph_engine.config import settings` (mai os.environ diretto)
#   4. Documentare la variabile qui sotto
# VIRUSTOTAL_API_KEY=      # es. verifica reputazione file/hash su VirusTotal
# SHODAN_API_KEY=          # es. banner passivo su Shodan InternetDB
# ABUSEIPDB_API_KEY=       # es. reputazione IP su AbuseIPDB
